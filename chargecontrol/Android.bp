android_app {
    name: "ChargeControl",
    defaults: [
        "SettingsLibDefaults",
    ],

    srcs: [
        "src/**/*.java"
    ],

    certificate: "platform",
    resource_dirs: ["res"],
    platform_apis: true,
    system_ext_specific: true,
    privileged: true,

    static_libs: [
        "androidx.core_core",
        "androidx.preference_preference",
    ],
}
